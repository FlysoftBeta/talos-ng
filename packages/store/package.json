{
  "name": "@talos/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/environment.ts"
  },
  "scripts": {
    "typecheck": "node ../../tools/typecheck.mjs -p tsconfig.json && node ../../tools/typecheck.mjs -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.mjs --project @talos/store && pnpm test:browser",
    "test:browser": "node tests/browser.mjs",
    "build": "pnpm typecheck && esbuild src/index.ts --bundle --format=esm --target=chrome70,es2018 --outfile=dist/store.js && node ../../tools/compat-check/cli.mjs dist",
    "test:browser:install": "node tests/install-browser.mjs"
  },
  "dependencies": {
    "@talos/base": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "playwright": "^1.56.0",
    "esbuild": "^0.25.0"
  }
}
