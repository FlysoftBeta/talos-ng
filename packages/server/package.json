{
  "name": "@talos/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migration": "./src/migration.ts"
  },
  "scripts": {
    "typecheck": "node ../../tools/typecheck.mjs -p tsconfig.json && node ../../tools/typecheck.mjs -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.mjs --project @talos/server",
    "build": "node build.mjs",
    "dev:server": "node --import tsx bin/talos-server.ts --dev"
  },
  "dependencies": {
    "@talos/base": "workspace:*",
    "@talos/contract": "workspace:*",
    "@talos/docpack": "workspace:*",
    "@talos/docpipe": "workspace:*",
    "@talos/launcher": "workspace:*",
    "@talos/link": "workspace:*",
    "@talos/objectstore": "workspace:*",
    "@talos/sync": "workspace:*",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
