{
  "name": "@talos/shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "node ../../tools/typecheck.mjs -p tsconfig.json && node ../../tools/typecheck.mjs -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.mjs --project @talos/shell",
    "build": "pnpm typecheck && esbuild src/sw.ts --bundle --format=iife --target=es2017 --outfile=dist/sw.js && node ../../tools/compat-check/cli.mjs dist"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "esbuild": "^0.25.0"
  }
}
